# Development-only config. This file is documentation, not auto-loaded.
# Bind HTTP servers to loopback only; never expose unauthenticated demo endpoints publicly.
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./aiadvisory.sqlite3
AI_ENABLED=false

# Optional local-demo reviewer shared secret; NOT authentication / rollout authority.
# On API server ONLY, export a random secret at least 16 characters.
# Never commit a real token, and do not send confidential business data to this app.
# ADVISORY_REVIEW_TOKEN=<set-locally>

# Phase 3: AI is opt-in. Keep these unset for rules-only local operation.
ADVISORY_AI_ENABLED=0
# ADVISORY_AI_ACCESS_TOKEN=long-unguessable-local-demo-secret
# ADVISORY_AI_API_KEY=secret-set-outside-version-control
ADVISORY_AI_MODEL=gpt-4.1-mini
# Every AI request must also affirm provider transmission and non-sensitive data.
# No unrestricted provider URLs, tool calling, or automated production actions.

# Optional dollar estimates require ALL three operator-verified values.
# ADVISORY_AI_INPUT_USD_PER_MILLION=
# ADVISORY_AI_OUTPUT_USD_PER_MILLION=
# ADVISORY_AI_PRICING_SOURCE=

# Phase 5: default-deny credentials on /api/v1. Unset in authenticated pilot:
# ADVISORY_DEMO_MODE=1   # ONLY synthetic loopback demos
# Provision locally: python -m scripts.admin issue --organization Example --subject user --role reviewer
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aiadvisory  # pip install '.[postgres]'

# Optional pilot IdP: required for OIDC access tokens, not for offline rules mode.
# ADVISORY_DEPLOYMENT_MODE=pilot        # local | pilot | production (production is gated)
# ADVISORY_OIDC_REQUIRED=1             # Reject pilot API tokens; OIDC-only
# ADVISORY_OIDC_ISSUER=https://login.example.com/realm
# ADVISORY_OIDC_AUDIENCE=aiadvisory-api
# ADVISORY_OIDC_JWKS_URL=https://login.example.com/realm/.well-known/jwks.json
# ADVISORY_REQUESTS_PER_MINUTE=120     # SQL-backed per org/subject/role; ingress WAF still required

# Phase 6: protected pilot mode requires OIDC-only, PostgreSQL and verified DB TLS.
# ADVISORY_DEPLOYMENT_MODE=pilot
# ADVISORY_OIDC_REQUIRED=1
# DATABASE_URL=postgresql+psycopg://user:password@db.example:5432/aiadvisory?sslmode=verify-full
# Mutations in pilot require If-Match: "<assessment revision>".
# ADVISORY_REQUIRE_IF_MATCH=1   # opt into preconditions for authenticated local tests
# GET /ready probes DB schema version; it does NOT certify production/IdP/privacy controls.
# Production mode deliberately refuses startup pending independent review.


# Phase 7 human approvals and collaboration:
# Protected pilot signoff automatically requires technical, security and business
# approval from three different authenticated people on the current revision.
# ADVISORY_REQUIRE_APPROVAL_CHAIN=1  # optional stricter authenticated local tests
# Organization administrator assigns an active reviewer via the /reviewer endpoint.
# In-app notifications are stored locally; no email/push delivery is guaranteed.
# Upgrade to migration 0007_collaboration before using v0.7.0.
